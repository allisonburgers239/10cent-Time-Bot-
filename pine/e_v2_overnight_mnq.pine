//@version=6
// Sleeve E v2 on micro Nasdaq futures (10c Time Bot)
// Buy at the 16:00 ET print, sell at the 09:30 ET print. 1 contract normally,
// 2 contracts on nights where the 2-day RSI of the 16:00 closes is below 10.
//
// Load on a 5-minute chart of CME_MINI:MNQ1! (1/15-minute also work).
// Orders fill at the NEXT bar's open (process_orders_on_close = false):
//   - the buy is placed on the 15:55 bar and fills at the 16:00 bar open;
//   - the sell is placed on the 09:25 bar and fills at the 09:30 bar open.
// Futures trade through both times, so no extended-hours setting is needed.
// MNQ1! is a continuous contract: each quarterly roll adds a small price jump
// that a real position would not feel. Expect small differences from reality.
strategy("E v2 overnight MNQ (10c)", overlay = true, process_orders_on_close = false,
     initial_capital = 25000, pyramiding = 0, calc_on_every_tick = false,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.62, slippage = 1,
     margin_long = 5, margin_short = 5)   // futures: ~5% intraday margin; without this TV rejects the 2-contract nights

useOverlay    = input.bool(true,  "RSI(2) < threshold -> more contracts")
rsiThr        = input.float(10.0, "RSI(2) threshold")
baseContracts = input.int(1,      "Contracts on a normal night")
signalMult    = input.int(2,      "Multiplier on a signal night")
warmup        = input.int(10,     "RSI warm-up days (no signal before)")
useGapHold    = input.bool(true,  "Gap-down hold: if 09:25 is <= -2% vs yesterday's 16:00, sell at 10:30 not 09:30")   // adopted 2026-11-05
gapThr        = input.float(-2.0, "Gap-down threshold, %")

if not timeframe.isminutes or timeframe.multiplier > 15
    runtime.error("Use a 1, 5 or 15-minute chart.")

minOfDay   = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
isEntryBar = minOfDay + timeframe.multiplier == 960   // 15:55 bar: next bar opens at 16:00
isPreOpen  = minOfDay + timeframe.multiplier == 570   // 09:25 bar: next bar opens at 09:30
isPre1030  = minOfDay + timeframe.multiplier == 630   // 10:25 bar: next bar opens at 10:30

var float prevClose = na
var float avgUp = na
var float avgDn = na
var float rsi2 = na
var int   nObs = 0
if isEntryBar
    if not na(prevClose)
        float d  = close - prevClose
        float up = math.max(d, 0.0)
        float dn = math.max(-d, 0.0)
        avgUp := na(avgUp) ? up : 0.5 * avgUp + 0.5 * up
        avgDn := na(avgDn) ? dn : 0.5 * avgDn + 0.5 * dn
        rsi2  := avgDn == 0 ? 100.0 : 100.0 - 100.0 / (1.0 + avgUp / avgDn)
    prevClose := close
    nObs += 1

signal = useOverlay and not na(rsi2) and nObs > warmup and rsi2 < rsiThr
int qty = signal ? baseContracts * signalMult : baseContracts

if isEntryBar and strategy.position_size == 0
    strategy.entry("ON", strategy.long, qty = qty, comment = signal ? "x" + str.tostring(signalMult) : "x1")

var bool holding = false
gapEst = not na(prevClose) ? close / prevClose - 1 : na   // 09:25 price vs yesterday's 16:00 print
if strategy.position_size > 0
    if isPreOpen
        if useGapHold and not na(gapEst) and gapEst * 100 <= gapThr
            holding := true
        else
            strategy.close("ON", comment = "open")           // fills at the 09:30 bar open
    else if holding and isPre1030
        strategy.close("ON", comment = "gap hold 10:30")     // fills at the 10:30 bar open
        holding := false
if strategy.position_size == 0
    holding := false

plotshape(isEntryBar and signal, title = "signal night", style = shape.triangleup, location = location.belowbar, color = color.orange, size = size.tiny)
plot(rsi2, title = "RSI(2) of daily closes", display = display.data_window)
