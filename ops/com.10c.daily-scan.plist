<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.10c.daily-scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/projects/10cent-time-bot" &amp;&amp; .venv/bin/python scripts/daily_scan.py &gt;&gt; results/scan_log_runs.txt 2&gt;&amp;1; .venv/bin/python scripts/scan_trend_exhaustion.py --log &gt;&gt; results/scan_log_runs.txt 2&gt;&amp;1; .venv/bin/python scripts/squeeze_scan.py --log &gt;&gt; results/scan_log_runs.txt 2&gt;&amp;1</string>
  </array>
  <!-- 09:00 local (Central) = 10:00 ET, Monday-Friday. Edit Hour if the Mac is not on Central time. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
